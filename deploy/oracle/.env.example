# Deployment configuration only. Copy this file to deploy/oracle/.env on the VM.
# Do not copy the developer workstation .env or commit the configured VM file.
DOMAIN=replace-with-your-domain.example.com
JUDGE_USER=replace-with-judge-user
# Run: docker run --rm -it caddy:2-alpine caddy hash-password
# Paste the complete bcrypt output BETWEEN SINGLE QUOTES below. Single quotes
# preserve each $ literally. Do not replace $ with $$ in this .env file.
JUDGE_PASSWORD_HASH=''

# Predictions and exports work with AI disabled. Optional server-side key only.
RAILGUARD_AI_ENABLED=false
OPENAI_API_KEY=''
RAILGUARD_AI_MODEL=gpt-5.4-mini
