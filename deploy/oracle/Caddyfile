{$DOMAIN} {
	# Authentication runs before either route, including downloads and health.
	route {
		basic_auth {
			{$JUDGE_USER} {$JUDGE_PASSWORD_HASH}
		}
		# API validates 64 MiB/file and 1500 MiB/batch. Leave multipart overhead.
		request_body {
			max_size 1536MiB
		}
		@api path /api /api/*
		handle @api {
			reverse_proxy backend:8000 {
				header_up -Authorization
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle {
			reverse_proxy frontend:3000 {
				header_up -Authorization
			}
		}
	}
	encode zstd gzip
}
